<Window x:Class="CSVRescue.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CSVRescue.ViewModels"
        xmlns:ctrl="clr-namespace:CSVRescue.Controls"
        xmlns:theme="clr-namespace:Mdah.Theming"
        mc:Ignorable="d"
        Title="CSVRescue"
        Icon="Assets/icon.ico"
        Height="800" Width="1160"
        MinHeight="600" MinWidth="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource Font.UI}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="KvValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="NavItem" TargetType="RadioButton" BasedOn="{StaticResource SidebarNavButtonStyle}">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBase}"
            BorderBrush="{DynamicResource SurfaceBorderStrong}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <ctrl:TitleBar Grid.Row="0"/>

            <Grid Grid.Row="1" x:Name="Body">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="208"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ───────── Navigation ───────── -->
                <Border Background="{DynamicResource SurfaceOverlay}" Padding="12,16,12,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=0}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Data="{StaticResource Svg.Search}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Open a file"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=1}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Data="{StaticResource Svg.Info}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="How it works"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <theme:ThemeToggleButton Margin="0,0,0,6"/>
                        <!-- Open source link -->
                        <Button Command="{Binding OpenRepositoryCommand}" Cursor="Hand" HorizontalContentAlignment="Stretch" ToolTip="Open the project on GitHub">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="10,8">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceInteractive}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource StatusSuccess}"/>
                                    <TextBlock Text="Free and open source" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding AppVersion, StringFormat=v{0} · MIT · GitHub}" Style="{StaticResource Label}" Margin="15,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource SurfaceBorder}"/>

                <!-- ───────── Content ───────── -->
                <Grid Grid.Column="2" Background="{DynamicResource SurfaceBase}">
                        <!-- ═════ OPEN A FILE ═════ -->
                        <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVis}, ConverterParameter=0}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,26,32,32" AllowDrop="True" Drop="OnDropFile" PreviewDragOver="OnDragOverFile">
                            <StackPanel MaxWidth="1000">
                                <TextBlock Text="Open a CSV that looks wrong" Style="{StaticResource PageTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,18"
                                           Text="Choose a CSV or text file (or drop it here). CSVRescue works out the encoding, the delimiter and the decimal mark, shows how the columns will look, keeps part numbers and leading zeros as text, and saves a clean CSV or Excel file. The original file is never changed."/>
                                <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" Padding="10,0" FontSize="14"
                                                 Background="{DynamicResource SurfaceSunken}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource SurfaceBorderStrong}" CaretBrush="{DynamicResource TextPrimary}"/>
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Open file…" Command="{Binding BrowseCommand}" Margin="12,0,0,0" MinWidth="110"/>
                                    </Grid>
                                </Border>

                                <StackPanel Visibility="{Binding HasFile, Converter={StaticResource BoolToVisConverter}}">
                                    <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding EncodingInfo}" Style="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding FormatInfo}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Problems}" FontSize="13" Foreground="{DynamicResource StatusWarning}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="How the file is read (change it if something looks wrong)" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Encoding" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                                    <ComboBox ItemsSource="{Binding Encodings}" SelectedIndex="{Binding EncodingIndex}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Delimiter" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                                    <WrapPanel>
                                                        <RadioButton GroupName="Delim" Content="Auto" IsChecked="{Binding DelimiterIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=0}" Margin="0,0,14,4" Foreground="{DynamicResource TextPrimary}"/>
                                                        <RadioButton GroupName="Delim" Content="Comma" IsChecked="{Binding DelimiterIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=1}" Margin="0,0,14,4" Foreground="{DynamicResource TextPrimary}"/>
                                                        <RadioButton GroupName="Delim" Content="Semicolon" IsChecked="{Binding DelimiterIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=2}" Margin="0,0,14,4" Foreground="{DynamicResource TextPrimary}"/>
                                                        <RadioButton GroupName="Delim" Content="Tab" IsChecked="{Binding DelimiterIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=3}" Margin="0,0,14,4" Foreground="{DynamicResource TextPrimary}"/>
                                                        <RadioButton GroupName="Delim" Content="Pipe" IsChecked="{Binding DelimiterIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=4}" Margin="0,0,14,4" Foreground="{DynamicResource TextPrimary}"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                            <WrapPanel Margin="0,12,0,0">
                                                <TextBlock Text="Decimal mark:" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <RadioButton GroupName="Dec" Content="Auto" IsChecked="{Binding DecimalIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=0}" Margin="0,0,14,0" Foreground="{DynamicResource TextPrimary}"/>
                                                <RadioButton GroupName="Dec" Content="Dot (1.5)" IsChecked="{Binding DecimalIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=1}" Margin="0,0,14,0" Foreground="{DynamicResource TextPrimary}"/>
                                                <RadioButton GroupName="Dec" Content="Comma (1,5)" IsChecked="{Binding DecimalIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=2}" Margin="0,0,24,0" Foreground="{DynamicResource TextPrimary}"/>
                                                <CheckBox IsChecked="{Binding HasHeader}" Content="First row is the header" Margin="0,0,18,0" Foreground="{DynamicResource TextPrimary}"/>
                                                <CheckBox IsChecked="{Binding Repair}" Content="Repair letters saved twice (é shown as Ã©)" Foreground="{DynamicResource TextPrimary}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="Columns" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                            <TextBlock Style="{StaticResource Label}" Margin="0,0,0,10" TextWrapping="Wrap" Text="Text keeps every character exactly (use it for part numbers, IDs, ZIP codes). Number stores real numbers in the Excel file. Press a button to switch."/>
                                            <ItemsControl ItemsSource="{Binding Columns}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="230"/>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding KindText}" Command="{Binding DataContext.ToggleKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,4" HorizontalAlignment="Left"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Risk}" FontSize="12" Foreground="{DynamicResource StatusWarning}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" Visibility="{Binding HasRisk, Converter={StaticResource BoolToVisConverter}}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="Preview" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding Preview}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ItemsControl ItemsSource="{Binding Cells}" Margin="0,0,0,2">
                                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" Width="150" Margin="0,0,10,0" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Panel}">
                                        <StackPanel>
                                            <TextBlock Text="Save the clean file" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                            <WrapPanel Margin="0,0,0,10">
                                                <TextBlock Text="CSV delimiter:" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <RadioButton GroupName="Out" Content="Comma" IsChecked="{Binding OutDelimiterIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=0}" Margin="0,0,14,0" Foreground="{DynamicResource TextPrimary}"/>
                                                <RadioButton GroupName="Out" Content="Semicolon (Excel in Europe)" IsChecked="{Binding OutDelimiterIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=1}" Margin="0,0,14,0" Foreground="{DynamicResource TextPrimary}"/>
                                                <RadioButton GroupName="Out" Content="Tab" IsChecked="{Binding OutDelimiterIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=2}" Foreground="{DynamicResource TextPrimary}"/>
                                            </WrapPanel>
                                            <WrapPanel Margin="0,0,0,14">
                                                <CheckBox IsChecked="{Binding Utf8Bom}" Content="UTF-8 with byte order mark (Excel reads accents correctly)" Margin="0,0,18,6" Foreground="{DynamicResource TextPrimary}"/>
                                                <CheckBox IsChecked="{Binding DecimalAsDot}" Content="Write decimal commas as dots in Number columns" Margin="0,0,18,6" Foreground="{DynamicResource TextPrimary}"/>
                                                <CheckBox IsChecked="{Binding ExcelProtect}" Content="Protect risky Text cells for Excel (written as =&quot;00123&quot;)" Foreground="{DynamicResource TextPrimary}"/>
                                            </WrapPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource PrimaryButton}" Content="Save as Excel (.xlsx)" Command="{Binding ExportXlsxCommand}" IsEnabled="{Binding CanExportXlsx}" Margin="0,0,8,0"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Save as CSV" Command="{Binding ExportCsvCommand}"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0,10,0,0" TextWrapping="Wrap" Text="Excel (.xlsx) keeps Text columns exactly as text. A plain CSV cannot: Excel decides for itself when it opens one, so use the protection option above or the .xlsx file."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <!-- ═════ HOW IT WORKS ═════ -->
                        <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVis}, ConverterParameter=1}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,26,32,32">
                            <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                                <TextBlock Text="How it works" Style="{StaticResource PageTitle}"/>
                                <Border Style="{StaticResource Panel}" Margin="0,18,0,12"><StackPanel>
                                    <TextBlock Text="What goes wrong with CSV files" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="A CSV carries no label for its encoding or its delimiter, so Excel guesses. Accents turn into Ã© or ?, everything lands in column A because the file uses semicolons, 1,5 is read as a date, part numbers lose their leading zeros, 1234567890123456 becomes 1.23457E+15 and 1E5 becomes 100000."/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource Panel}" Margin="0,0,0,12"><StackPanel>
                                    <TextBlock Text="What CSVRescue does" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="It reads the bytes and tells you how it decided: byte order mark, UTF-16 without one, valid UTF-8, or the old Windows encoding as the fallback (you can pick another from the list, for example Cyrillic or Japanese). The delimiter is the one that splits the first rows into the same number of columns. Quoted fields, doubled quotes and line breaks inside quotes are read correctly. Text saved as UTF-8 twice (é shown as Ã©) is repaired when the repair is clean."/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource Panel}" Margin="0,0,0,12"><StackPanel>
                                    <TextBlock Text="Text or number" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="A column becomes Number only if every value is a clean number: no leading zeros, at most 15 digits, no 1E5 or date look. Everything else is Text and is written exactly as it is. In the .xlsx file Text cells have the Excel text format, so nothing is converted later. Decimal commas and thousands separators are understood in Number columns."/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource Panel}" Margin="0,0,0,12"><StackPanel>
                                    <TextBlock Text="The original is safe" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="CSVRescue only reads the file you open and only writes the new files you save; it refuses to overwrite the original. Files up to 300 MB open; Excel files hold at most 1,048,576 rows."/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource Panel}"><StackPanel>
                                    <TextBlock Text="Free and private" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="CSVRescue is free and open source (MIT). It makes no network connections: nothing is sent anywhere, and there is no account, licence key or telemetry."/>
                                </StackPanel></Border>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Toast -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24" MaxWidth="720" CornerRadius="10" Padding="16,11"
                                Background="{DynamicResource SurfaceInteractive}" BorderBrush="{DynamicResource SurfaceBorderStrong}" BorderThickness="1"
                                Visibility="{Binding IsStatusBannerVisible, Converter={StaticResource BoolToVisConverter}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource StatusInfo}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusBannerType}" Value="Success"><Setter Property="Fill" Value="{DynamicResource StatusSuccess}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StatusBannerType}" Value="Warning"><Setter Property="Fill" Value="{DynamicResource StatusWarning}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StatusBannerType}" Value="Error"><Setter Property="Fill" Value="{DynamicResource StatusError}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusBannerMessage}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="600" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding DismissBannerCommand}" Content="✕" ToolTip="Dismiss" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondary}" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </Grid>

            </Grid>

            <ctrl:StatusBar Grid.Row="2"/>
        </Grid>
    </Border>
</Window>
