{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CSVRescue",
  "version": "2.1.0",
  "identifier": "com.mdanamulhasan.csvrescue",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../src-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CSVRescue",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset:; connect-src 'self' ipc:;"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Md Anamul Hasan",
    "shortDescription": "Privacy-first, deterministic CSV repair and recovery desktop app",
    "longDescription": "Diagnose, repair, analyze, validate, and export malformed or damaged CSV files without sending data to third parties."
  },
  "plugins": {}
}
